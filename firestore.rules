rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }
    function isAdmin() {
      return myRole() == 'admin';
    }
    function isFaculty() {
      return myRole() == 'faculty';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users: anyone signed in can read profiles (needed for rosters/reports).
    // Users can only create/edit their own profile, except admins can edit any.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isOwner(uid) || isAdmin();
    }

    // Reference data: everyone signed in can read; only admins write.
    match /departments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /classes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFaculty();
    }
    match /timetable/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFaculty();
    }

    // Sessions: faculty create/manage their own; students only need read
    // access to validate a scanned QR (they already have the doc ID + token).
    match /sessions/{id} {
      allow read: if isSignedIn();
      allow create: if isFaculty() && request.resource.data.facultyId == request.auth.uid;
      allow update: if isFaculty() && resource.data.facultyId == request.auth.uid;
    }

    // Attendance: students can create their own QR-marked record; faculty
    // can create/update manual marks and corrections; admins read all.
    match /attendance/{id} {
      allow read: if isSignedIn();
      allow create: if (isSignedIn() && request.resource.data.studentId == request.auth.uid)
                    || isFaculty() || isAdmin();
      allow update: if isFaculty() || isAdmin();
    }

    // Leave requests: students manage their own; faculty/admin can update status.
    match /leaves/{id} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.studentId);
      allow update: if isFaculty() || isAdmin();
    }

    // Notifications: users only see their own.
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Announcements: everyone reads; only admin/faculty post.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFaculty();
    }
  }
}
